{"abstract":[{"type":"text","text":"Bound batch processing and prevent outdated requests from updating UI state."}],"seeAlsoSections":[{"identifiers":["doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting"],"title":"Guides","anchor":"Guides","generated":true}],"metadata":{"role":"article","title":"Concurrent work","modules":[{"name":"TaskLoom"}],"roleHeading":"Article"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Bound-a-collection-transform","type":"heading","text":"Bound a collection transform"},{"code":["let thumbnails = try await photos.concurrentMap(maxConcurrency: 4) {","    try await makeThumbnail(for: $0)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The limit must be positive. The result preserves input order, including optional values, while at most four child tasks execute transforms. Failure cancels remaining children; parent cancellation stops further scheduling. Structured concurrency still waits for children to finish, so transforms must cooperate with cancellation."}]},{"level":2,"anchor":"Deliver-only-the-latest-request","type":"heading","text":"Deliver only the latest request"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a "},{"code":"LatestTask","type":"codeVoice"},{"type":"text","text":" coordinator on the main actor:"}]},{"code":["@MainActor","final class SearchModel {","    private let search = LatestTask()","    var results: [String] = []","","    func update(query: String) {","        search.submit(operation: {","            try await searchService(query)","        }, onCompletion: { [weak self] result in","            if case .success(let values) = result {","                self?.results = values","            }","        })","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Submitting cancels the previous request and creates a new generation. Only the current generation can deliver a result, even if earlier work ignores cancellation. Completion runs synchronously on the main actor, keeping the generation check and state update together. Ordinary failures are delivered as "},{"type":"codeVoice","code":"Result.failure"},{"type":"text","text":"; cancelled or superseded work does not deliver results."}]},{"inlineContent":[{"type":"codeVoice","code":"cancel()"},{"type":"text","text":" invalidates pending delivery immediately. The returned task handle can be awaited for actual completion. "},{"code":"isRunning","type":"codeVoice"},{"text":" describes the current request, not any superseded work still finishing. Keep the coordinator alive for the requests it coordinates; avoid strong capture cycles in long-running closures. The operation closure is Sendable and the utility does not promise a background thread.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/ConcurrentWork","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/TaskLoom\/documentation\/TaskLoom"]]},"variants":[{"paths":["\/documentation\/taskloom\/concurrentwork"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TaskLoom/documentation/TaskLoom":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom","abstract":[{"text":"Compose asynchronous work, manage task lifetimes, and bridge Swift concurrency with Combine.","type":"text"}],"title":"TaskLoom","type":"topic","url":"\/documentation\/taskloom","kind":"symbol","role":"collection"},"doc://TaskLoom/documentation/TaskLoom/CancellationAndRetries":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","abstract":[{"type":"text","text":"Understand policy ordering and cooperative cancellation before composing work."}],"type":"topic","url":"\/documentation\/taskloom\/cancellationandretries","kind":"article","role":"article","title":"Cancellation and retries"},"doc://TaskLoom/documentation/TaskLoom/TaskLifetimes":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","abstract":[{"type":"text","text":"Keep ownership explicit when creating and retaining asynchronous work."}],"title":"Task lifetimes","kind":"article","url":"\/documentation\/taskloom\/tasklifetimes","type":"topic","role":"article"},"doc://TaskLoom/documentation/TaskLoom/DebuggingAndTesting":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting","abstract":[{"type":"text","text":"Name operations, inspect their lifecycle, and advance time explicitly in tests."}],"title":"Debugging and testing","type":"topic","url":"\/documentation\/taskloom\/debuggingandtesting","kind":"article","role":"article"},"doc://TaskLoom/documentation/TaskLoom/CombineAndDispatch":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","abstract":[{"text":"Use the platform bridges alongside the portable concurrency APIs.","type":"text"}],"title":"Combine and Dispatch","type":"topic","url":"\/documentation\/taskloom\/combineanddispatch","kind":"article","role":"article"},"doc://TaskLoom/documentation/TaskLoom/GettingStarted":{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","abstract":[{"type":"text","text":"Build a reusable asynchronous operation and choose the policies that surround it."}],"title":"Getting started","type":"topic","url":"\/documentation\/taskloom\/gettingstarted","kind":"article","role":"article"}}}