{"metadata":{"modules":[{"name":"TaskLoom"}],"role":"article","roleHeading":"Article","title":"Concurrent work"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting"],"anchor":"Guides"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Bound-a-collection-transform","level":2,"text":"Bound a collection transform","type":"heading"},{"code":["let thumbnails = try await photos.concurrentMap(maxConcurrency: 4) {","    try await makeThumbnail(for: $0)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The limit must be positive. The result preserves input order, including optional values, while at most four child tasks execute transforms. Failure cancels remaining children; parent cancellation stops further scheduling. Structured concurrency still waits for children to finish, so transforms must cooperate with cancellation."}]},{"level":2,"text":"Deliver only the latest request","type":"heading","anchor":"Deliver-only-the-latest-request"},{"type":"paragraph","inlineContent":[{"text":"Keep a ","type":"text"},{"type":"codeVoice","code":"LatestTask"},{"text":" coordinator on the main actor:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","final class SearchModel {","    private let search = LatestTask()","    var results: [String] = []","","    func update(query: String) {","        search.submit(operation: {","            try await searchService(query)","        }, onCompletion: { [weak self] result in","            if case .success(let values) = result {","                self?.results = values","            }","        })","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Submitting cancels the previous request and creates a new generation. Only the current generation can deliver a result, even if earlier work ignores cancellation. Completion runs synchronously on the main actor, keeping the generation check and state update together. Ordinary failures are delivered as ","type":"text"},{"type":"codeVoice","code":"Result.failure"},{"text":"; cancelled or superseded work does not deliver results.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cancel()"},{"text":" invalidates pending delivery immediately. The returned task handle can be awaited for actual completion. ","type":"text"},{"type":"codeVoice","code":"isRunning"},{"text":" describes the current request, not any superseded work still finishing. Keep the coordinator alive for the requests it coordinates; avoid strong capture cycles in long-running closures. The operation closure is Sendable and the utility does not promise a background thread.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/ConcurrentWork","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/taskloom\/concurrentwork"]}],"hierarchy":{"paths":[["doc:\/\/TaskLoom\/documentation\/TaskLoom"]]},"sections":[],"abstract":[{"type":"text","text":"Bound batch processing and prevent outdated requests from updating UI state."}],"references":{"doc://TaskLoom/documentation/TaskLoom/CancellationAndRetries":{"title":"Cancellation and retries","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","type":"topic","kind":"article","abstract":[{"text":"Understand policy ordering and cooperative cancellation before composing work.","type":"text"}],"role":"article","url":"\/documentation\/taskloom\/cancellationandretries"},"doc://TaskLoom/documentation/TaskLoom/DebuggingAndTesting":