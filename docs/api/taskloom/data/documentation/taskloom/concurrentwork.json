{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Concurrent work","role":"article","modules":[{"name":"TaskLoom"}],"roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Bound-a-collection-transform","type":"heading","text":"Bound a collection transform"},{"code":["let thumbnails = try await photos.concurrentMap(maxConcurrency: 4) {","    try await makeThumbnail(for: $0)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The limit must be positive. The result preserves input order, including optional values, while at most four child tasks execute transforms. Failure cancels remaining children; parent cancellation stops further scheduling. Structured concurrency still waits for children to finish, so transforms must cooperate with cancellation."}],"type":"paragraph"},{"text":"Deliver only the latest request","level":2,"anchor":"Deliver-only-the-latest-request","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep a "},{"code":"LatestTask","type":"codeVoice"},{"type":"text","text":" coordinator on the main actor:"}]},{"code":["@MainActor","final class SearchModel {","    private let search = LatestTask()","    var results: [String] = []","","    func update(query: String) {","        search.submit(operation: {","            try await searchService(query)","        }, onCompletion: { [weak self] result in","            if case .success(let values) = result {","                self?.results = values","            }","        })","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Submitting cancels the previous request and creates a new generation. Only the current generation can deliver a result, even if earlier work ignores cancellation. Completion runs synchronously on the main actor, keeping the generation check and state update together. Ordinary failures are delivered as "},{"code":"Result.failure","type":"codeVoice"},{"type":"text","text":"; cancelled or superseded work does not deliver results."}]},{"type":"paragraph","inlineContent":[{"code":"cancel()","type":"codeVoice"},{"type":"text","text":" invalidates pending delivery immediately. The returned task handle can be awaited for actual completion. "},{"code":"isRunning","type":"codeVoice"},{"type":"text","text":" describes the current request, not any superseded work still finishing. Keep the coordinator alive for the requests it coordinates; avoid strong capture cycles in long-running closures. The operation closure is Sendable and the utility does not promise a background thread."}]}]}],"sections":[],"identifier":{"url":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/ConcurrentWork","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TaskLoom\/documentation\/TaskLoom"]]},"abstract":[{"type":"text","text":"Bound batch processing and prevent outdated requests from updating UI state."}],"variants":[{"paths":["\/documentation\/taskloom\/concurrentwork"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://TaskLoom/documentation/TaskLoom/CombineAndDispatch":{"url":"\/documentation\/taskloom\/combineanddispatch","role":"article","title":"Combine and Dispatch","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","type":"topic","abstract":[{"text":"Use the platform bridges alongside the portable concurrency APIs.","type":"text"}],"kind":"article"},"doc://TaskLoom/documentation/TaskLoom":{"role":"collection","url":"\/documentation\/taskloom","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom","title":"TaskLoom","abstract":[{"text":"Compose asynchronous work, manage task lifetimes, and bridge Swift concurrency with Combine.","type":"text"}],"kind":"symbol","type":"topic"},"doc://TaskLoom/documentation/TaskLoom/DebuggingAndTesting":{"url":"\/documentation\/taskloom\/debuggingandtesting","role":"article","title":"Debugging and testing","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting","type":"topic","abstract":[{"text":"Name operations, inspect their lifecycle, and advance time explicitly in tests.","type":"text"}],"kind":"article"},"doc://TaskLoom/documentation/TaskLoom/CancellationAndRetries":{"url":"\/documentation\/taskloom\/cancellationandretries","role":"article","title":"Cancellation and retries","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","type":"topic","kind":"article","abstract":[{"type":"text","text":"Understand policy ordering and cooperative cancellation before composing work."}]},"doc://TaskLoom/documentation/TaskLoom/TaskLifetimes":{"role":"article","url":"\/documentation\/taskloom\/tasklifetimes","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","title":"Task lifetimes","abstract":[{"text":"Keep ownership explicit when creating and retaining asynchronous work.","type":"text"}],"kind":"article","type":"topic"},"doc://TaskLoom/documentation/TaskLoom/GettingStarted":{"role":"article","url":"\/documentation\/taskloom\/gettingstarted","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","title":"Getting started","abstract":[{"text":"Build a reusable asynchronous operation and choose the policies that surround it.","type":"text"}],"kind":"article","type":"topic"}}}