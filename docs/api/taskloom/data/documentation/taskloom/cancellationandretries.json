{"abstract":[{"text":"Understand policy ordering and cooperative cancellation before composing work.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"TaskLoom"}],"title":"Cancellation and retries"},"identifier":{"url":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CancellationAndRetries","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting","doc:\/\/TaskLoom\/documentation\/TaskLoom\/ConcurrentWork"],"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/taskloom\/cancellationandretries"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TaskLoom\/documentation\/TaskLoom"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Policy order","type":"heading","anchor":"Policy-order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifiers wrap the operation built so far. "},{"type":"codeVoice","code":".retry(3).timeout(.seconds(5))"},{"type":"text","text":" gives the whole sequence a five-second timeout. "},{"type":"codeVoice","code":".timeout(.seconds(5)).retry(3)"},{"type":"text","text":" gives each attempt its own timeout. The retry count includes the initial attempt and must be positive."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/BackoffStrategy","type":"reference","isActive":true},{"text":" provides constant, linear, exponential, jittered exponential, and custom delays. Exhausted retries throw ","type":"text"},{"type":"codeVoice","code":"AsyncOperationError.maxRetriesExceeded"},{"text":", preserving the last error. Cancellation is checked before each attempt and before backoff. Cancellation errors never retry. Use ","type":"text"},{"code":"retry(_:backoff:when:)","type":"codeVoice"},{"text":" to select eligible failures; rejected errors propagate unchanged.","type":"text"}]},{"level":2,"text":"Cooperative timeouts","type":"heading","anchor":"Cooperative-timeouts"},{"type":"paragraph","inlineContent":[{"text":"Timeouts race work against a sleeping child task. The losing child is cancelled, but the task group must wait for every child to exit. A timeout is therefore a cancellation request, not a guarantee that the function returns at a wall-clock deadline. Use cancellation-aware suspension points and ","type":"text"},{"type":"codeVoice","code":"Task.checkCancellation()"},{"text":" in long-running work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/AsyncTask","isActive":true,"type":"reference"},{"text":" expresses timeouts with a default value. It cannot throw ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" to its caller. Converting an operation with ","type":"text"},{"type":"codeVoice","code":"toTask(default:)"},{"text":" also turns all errors, including cancellation, into the supplied default.","type":"text"}]},{"anchor":"Races-and-fallback","level":2,"text":"Races and fallback","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"AsyncOperation.race","type":"codeVoice"},{"text":" uses the first completed result, which may be an error. It does not wait for the first success after an earlier failure. Losing child tasks are cancelled cooperatively.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"fallback","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"recover","type":"codeVoice"},{"text":" propagate ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AsyncOperationError.cancelled"},{"text":", and the current task’s cancellation state. ","type":"text"},{"type":"codeVoice","code":"recover"},{"text":" receives ordinary errors so it can select a replacement value. ","type":"text"},{"type":"codeVoice","code":"checkCancellation()"},{"type":"text","text":" checks immediately before starting its wrapped work; it does not automatically insert checks inside your closure."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"allSettled"},{"type":"text","text":" retains one "},{"type":"codeVoice","code":"Result"},{"type":"text","text":" for every input in input order. Individual child failures, including child cancellation errors, become results; cancellation of the parent cancels the group and throws. Choose "},{"type":"codeVoice","code":"all"},{"type":"text","text":" when an unsuccessful child must fail the overall operation."}]},{"anchor":"Injectable-timing","level":2,"text":"Injectable timing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Timeouts and retries accept ","type":"text"},{"type":"codeVoice","code":"clock:"},{"text":" overloads. ","type":"text"},{"code":"DelayedTask","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RepeatingTask","type":"codeVoice"},{"text":" accept ","type":"text"},{"code":"Duration","type":"codeVoice"},{"text":" plus ","type":"text"},{"type":"codeVoice","code":"clock:"},{"text":"; their handlers remain on the main actor. A throwing delayed task propagates cancellation. See ","type":"text"},{"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting","isActive":true,"type":"reference"},{"text":" for deterministic tests.","type":"text"}]}],"kind":"content"}],"references":{"doc://TaskLoom/documentation/TaskLoom/TaskLifetimes":{"title":"Task lifetimes","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/TaskLifetimes","type":"topic","kind":"article","abstract":[{"text":"Keep ownership explicit when creating and retaining asynchronous work.","type":"text"}],"role":"article","url":"\/documentation\/taskloom\/tasklifetimes"},"doc://TaskLoom/documentation/TaskLoom/DebuggingAndTesting":{"title":"Debugging and testing","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/DebuggingAndTesting","type":"topic","kind":"article","abstract":[{"type":"text","text":"Name operations, inspect their lifecycle, and advance time explicitly in tests."}],"role":"article","url":"\/documentation\/taskloom\/debuggingandtesting"},"doc://TaskLoom/documentation/TaskLoom/GettingStarted":{"title":"Getting started","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Build a reusable asynchronous operation and choose the policies that surround it.","type":"text"}],"role":"article","url":"\/documentation\/taskloom\/gettingstarted"},"doc://TaskLoom/documentation/TaskLoom/BackoffStrategy":{"abstract":[{"text":"Defines strategies for calculating delay between retry attempts.","type":"text"}],"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/BackoffStrategy","role":"symbol","navigatorTitle":[{"text":"BackoffStrategy","kind":"identifier"}],"url":"\/documentation\/taskloom\/backoffstrategy","kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffStrategy","kind":"identifier"}],"title":"BackoffStrategy"},"doc://TaskLoom/documentation/TaskLoom/ConcurrentWork":{"title":"Concurrent work","url":"\/documentation\/taskloom\/concurrentwork","type":"topic","kind":"article","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/ConcurrentWork","abstract":[{"text":"Bound batch processing and prevent outdated requests from updating UI state.","type":"text"}],"role":"article"},"doc://TaskLoom/documentation/TaskLoom/CombineAndDispatch":{"title":"Combine and Dispatch","url":"\/documentation\/taskloom\/combineanddispatch","type":"topic","kind":"article","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/CombineAndDispatch","abstract":[{"text":"Use the platform bridges alongside the portable concurrency APIs.","type":"text"}],"role":"article"},"doc://TaskLoom/documentation/TaskLoom/AsyncTask":{"abstract":[{"type":"text","text":"A composable, lazy async task that cannot fail."}],"identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/AsyncTask","role":"symbol","navigatorTitle":[{"text":"AsyncTask","kind":"identifier"}],"url":"\/documentation\/taskloom\/asynctask","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncTask","kind":"identifier"}],"title":"AsyncTask"},"doc://TaskLoom/documentation/TaskLoom":{"title":"TaskLoom","url":"\/documentation\/taskloom","kind":"symbol","type":"topic","identifier":"doc:\/\/TaskLoom\/documentation\/TaskLoom","abstract":[{"text":"Compose asynchronous work, manage task lifetimes, and bridge Swift concurrency with Combine.","type":"text"}],"role":"collection"}}}