{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Waits until a permit is available, then acquires it.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"wait"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"If a permit is immediately available, this method returns without suspending."},{"type":"text","text":" "},{"type":"text","text":"Otherwise, it suspends until a permit becomes available via "},{"type":"codeVoice","code":"signal()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Waiting does not observe task cancellation; a cancelled waiter still needs"},{"type":"text","text":" "},{"type":"text","text":"a permit to resume. Prefer "},{"type":"codeVoice","code":"withPermit"},{"type":"text","text":" to ensure the permit is released."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/taskloom\/asyncsemaphore\/wait()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TaskLoom\/documentation\/TaskLoom\/AsyncSemaphore\/wait()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TaskLoom\/documentation\/TaskLoom","doc:\/\/TaskLoom\/documentation\/TaskLoom\/AsyncSemaphore"]]},"sections":[],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"wait"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"role":"symbol","symbolKind":"method","externalID":"s:8TaskLoom14AsyncSemaphoreC4waityyYaF","roleHeading":"Instance Method","modules":[{"name":"TaskLoom"}],"title":"wait()"},"references":{"doc://TaskLoom/documentation/TaskLoom/AsyncSemaphore/wait()":{"type":"topic"