---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Composable task orchestration for Swift concurrency, with Combine and Dispatch utilities." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#122427" />
    <title>{title} · TaskLoom</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={`${base}/`}>TaskLoom<span>Swift concurrency, composed.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}/documentation/`}>Documentation</a>
        <a href={`${base}/api/taskloom/documentation/taskloom/`}>API reference</a>
        <a href="https://github.com/modern-swift-dev/taskloom-swift">GitHub ↗</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>TaskLoom · MIT licensed · Swift 6.2 · Preparing the first public release</footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: dark; font-family: ui-sans-serif, system-ui, sans-serif; background: #122427; color: #eff7f4; font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: #a8e5cf; text-underline-offset: .2em; }
  a:hover { color: white; }
  a:focus-visible { outline: 3px solid #f7c98b; outline-offset: 5px; }
  header, main, footer { max-width: 1100px; margin: auto; padding: 2rem; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 2rem; border-bottom: 1px solid #395152; }
  .brand { font-size: 1.5rem; font-weight: 750; text-decoration: none; color: #fff; }
  .brand span { display: block; font-size: .75rem; font-weight: 400; color: #b3c7c6; margin-top: .3rem; }
  nav { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: .9rem; }
  nav a { text-decoration: none; }
  main { min-height: 70vh; padding-top: 4rem; padding-bottom: 5rem; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.8rem); line-height: 1.05; letter-spacing: -.055em; max-width: 900px; margin: 1rem 0 1.5rem; }
  h2 { font-size: 1.6rem; letter-spacing: -.025em; margin-top: 2.5rem; }
  p, li { line-height: 1.75; color: #cfddda; }
  p { max-width: 72ch; }
  .lead { font-size: 1.2rem; max-width: 65ch; }
  .eyebrow { color: #f7c98b; text-transform: uppercase; letter-spacing: .13em; font-size: .8rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin: 2rem 0; }
  .button { background: #a8e5cf; color: #122427; padding: .7rem 1.2rem; border-radius: 7px; text-decoration: none; font-weight: 650; }
  .button:hover { background: #d5faec; color: #122427; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin: 2rem 0; }
  .card { border: 1px solid #395152; padding: 1.5rem; border-radius: 10px; background: #193034; }
  .card h2 { margin-top: 0; font-size: 1.25rem; }
  pre { overflow-x: auto; padding: 1.5rem; border: 1px solid #395152; border-radius: 10px; font-size: .92rem; line-height: 1.65; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  :not(pre) > code { color: #f7d6aa; font-size: .92em; }
  footer { border-top: 1px solid #395152; font-size: .8rem; color: #b3c7c6; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 1rem; top: 1rem; background: #122427; padding: 1rem; z-index: 2; }
  @media (max-width: 650px) { header { align-items: flex-start; flex-direction: column; } header, main, footer { padding: 1.5rem; } main { padding-top: 3rem; } nav { gap: 1rem; } }
</style>
